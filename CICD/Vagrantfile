    nx01.vm.network "private_network", ip: "192.168.56.17"

    nx01.vm.provider "virtualbox" do |vb|
      vb.memory = "3072"
      vb.cpus = 2
    end

  end

  ### Monitoring - Prometheus - Grafana ###
   config.vm.define "prometheus01" do |pt01|

