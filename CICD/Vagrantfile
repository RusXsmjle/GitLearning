Vagrant.configure("2") do |config|

  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true
  config.hostmanager.manage_guest = true


  ### Jenkins ###
  config.vm.define "jenkins01" do |jk01|

    jk01.vm.box = "generic/centos9s"
    jk01.vm.hostname = "jk01"
    jk01.vm.network "private_network", ip: "192.168.56.15"

    jk01.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end
  end
  ### SonarQube ###
  config.vm.define "sonar01" do |sn01|

